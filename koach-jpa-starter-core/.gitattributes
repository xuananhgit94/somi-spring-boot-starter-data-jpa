# ========== General Rules ==========
* text=auto eol=lf

# ========== OS-specific Scripts ==========
*.sh     text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
/mvnw    text eol=lf
/mvnw.cmd text eol=crlf

# ========== Source Code Files ==========
*.java       text eol=lf
*.kt         text eol=lf
*.groovy     text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.properties text eol=lf

# ========== Text and Config Files ==========
*.md         text eol=lf
*.txt        text eol=lf
*.gitignore  text eol=lf
*.gitattributes text eol=lf

# ========== Binary ==========
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary